# Johnny V0.1 Environment Configuration

# NVIDIA NIM API Settings
# DO NOT put your real key here if you plan to share/push this project!
# Preferred: run `python setup_keys.py` FIRST — it asks for your key once and
# stores it in .johnny/credentials/api_keys.env (0600, gitignored).
# (.env is for public-ish config; NIM_API_KEY here is only for private setups.)
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Centralized Model Configuration
LLAMA_MODEL_ID=meta/llama-3.3-70b-instruct
MINIMAX_MODEL_ID=minimax/minimax-m3
DEEPSEEK_MODEL_ID=deepseek-ai/deepseek-r1
NEMOTRON_MODEL_ID=nvidia/nemotron-4-340b-instruct

# Provider Selection (nim | mock)
MODEL_PROVIDER=mock

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Local API auth token (auto-generated into .johnny/credentials/api_token if unset)
# JOHNNY_API_TOKEN=change-me-to-a-strong-random-token

# Optional browser egress allowlist (comma-separated hosts; enforced when set)
# JOHNNY_EGRESS_ALLOWLIST=
